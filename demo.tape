# VHS Documentation for Nahkoda - Feature Showcase
# Demonstrasi fitur-fitur utama Nahkoda CLI

# Set up the terminal
Output nahkoda_demo.gif
Set FontSize 18
Set Width 1400
Set Height 800
Set Theme "Catppuccin Mocha"
Set TypingSpeed 80ms
Set PlaybackSpeed 1.0

# Title screen
Type "# ⚓ Nahkoda - Kubernetes dalam Bahasa Indonesia"
Enter
Sleep 1s
Type "# Demo: POD, Deployment, Namespace, Node, dan REPL Mode"
Enter
Sleep 2s
Ctrl+L

# 1. POD (Kru)
Type "# 1️⃣ Lihat semua Pod (Kru)"
Enter
Sleep 500ms
Type "./nahkoda liat kru"
Enter
Sleep 3s
Ctrl+L

# 2. Deployment (Armada)
Type "# 2️⃣ Lihat semua Deployment (Armada)"
Enter
Sleep 500ms
Type "./nahkoda liat armada"
Enter
Sleep 3s
Ctrl+L

# 3. Namespace (Geladak)
Type "# 3️⃣ Lihat semua Namespace (Geladak)"
Enter
Sleep 500ms
Type "./nahkoda liat geladak"
Enter
Sleep 3s
Ctrl+L

# 4. Node (Mesin)
Type "# 4️⃣ Lihat semua Node (Mesin)"
Enter
Sleep 500ms
Type "./nahkoda liat mesin"
Enter
Sleep 3s
Ctrl+L

# 5. Filter by Namespace
Type "# 5️⃣ Lihat Pod di Namespace tertentu"
Enter
Sleep 500ms
Type "./nahkoda liat kru di geladak kube-system"
Enter
Sleep 3s
Ctrl+L

# 6. Read Logs
Type "# 6️⃣ Baca Log Pod"
Enter
Sleep 500ms
Type "./nahkoda baca jurnal coredns-123"
Enter
Sleep 3s
Ctrl+L

# 7. REPL Mode Demo
Type "# 7️⃣ Mode Interaktif (REPL) dengan Auto-Suggestion"
Enter
Sleep 1s
Type "./nahkoda"
Enter
Sleep 2s

# Inside REPL - Command 1
Type "liat kru"
Enter
Sleep 2s

# Inside REPL - Command 2
Type "liat armada"
Enter
Sleep 2s

# Inside REPL - Command 3
Type "liat geladak"
Enter
Sleep 2s

# Exit REPL
Type "keluar"
Enter
Sleep 1s
Ctrl+L

# Closing
Type "# ✅ Demo Selesai!"
Enter
Sleep 1s
Type "# 📖 Dokumentasi: https://budimanr3101.github.io/nahkoda/"
Enter
Type "# ⭐ GitHub: https://github.com/budimanr3101/nahkoda"
Enter
Sleep 3s
